#!/bin/bash

echo "Waiting for apt locks to be released..."
while fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/cache/apt/archives/lock >/dev/null 2>&1; do
    echo "System updates are in progress. Waiting 5 seconds..."
    sleep 5
done
echo "Apt is free. Proceeding with installation."

DEVICE_NAME="google-anki-data-disk"
MOUNT_PATH="/mnt/data"
DISK_PATH="/dev/disk/by-id/$DEVICE_NAME"

if mountpoint -q "$MOUNT_PATH"; then
  echo "Disk is already mounted to $MOUNT_PATH. Skipping setup."
else
  mkdir -p "$MOUNT_PATH"
  echo "Checking for persistent disk at $DISK_PATH..."
  while [ ! -b "$DISK_PATH" ]; do
    echo "Waiting for disk $DEVICE_NAME to attach..."
    sleep 2
  done

  if ! blkid "$DISK_PATH" > /dev/null; then
    echo "New disk detected. Formatting with ext4..."
    sudo mkfs.ext4 -F -E lazy_itable_init=0,lazy_journal_init=0,discard "$DISK_PATH"
  fi

  mount "$DISK_PATH" "$MOUNT_PATH"

  if ! grep -qs "$MOUNT_PATH" /etc/fstab; then
    echo "$DISK_PATH $MOUNT_PATH ext4 discard,defaults,nofail 0 2" >> /etc/fstab
  fi

  echo "Persistent disk mounted successfully to $MOUNT_PATH"
fi

TARGET_USER=$(curl -s "http://metadata.google.internal/computeMetadata/v1/instance/attributes/ssh-keys" -H "Metadata-Flavor: Google" | cut -d: -f1 | head -n 1)
echo "Target user: $TARGET_USER"

echo "Adding Docker's official GPG key"
sudo apt update
sudo apt install ca-certificates curl -y
sudo install -m 0755 -d /etc/apt/keyrings
sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
sudo chmod a+r /etc/apt/keyrings/docker.asc

echo "Adding the repository to Apt sources"
sudo tee /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: $(. /etc/os-release && echo "$VERSION_CODENAME")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

echo "Running apt update"
sudo apt-get update

echo "Installing Docker"
sudo apt install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin --assume-yes

echo "Running Anki Desktop docker container"
mkdir -p "$MOUNT_PATH/anki_data"
docker run -d \
    --name anki-desktop \
    -e PUID=1000 \
    -e PGID=1000 \
    -v "$MOUNT_PATH/anki_data:/config" \
    -p 3000:3000 \
    -p 8765:8765 \
    mlcivilengineer/anki-desktop-docker:main

export DISCORD_TOKEN=$(gcloud secrets versions access latest --secret="DISCORD_TOKEN")
export GOOGLE_CLOUD_PROJECT=${project_name}
export DESKTOP_LOCAL_IP="localhost"
export DISCORD_APP_ID=${discord_app_id}
export GOOGLE_CLOUD_REGION=${project_region}

echo "Running ankibot docker container"
docker run -d \
    --name anki-bot \
    -e DISCORD_TOKEN \
    -e GOOGLE_CLOUD_PROJECT \
    -e DESKTOP_LOCAL_IP \
    -e DISCORD_APP_ID \
    -e GOOGLE_CLOUD_REGION \
    --net=host \
    docker.io/maizecyber/ankibot:gcpv2.5

sudo chown -R "$TARGET_USER:$TARGET_USER" "$MOUNT_PATH"
echo "Startup script complete"